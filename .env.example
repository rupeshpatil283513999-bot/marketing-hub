# Add these in Netlify: Site configuration > Environment variables.
# (For local testing you do not need any of them: `npm run digest:dry` uses sample data.)

# ---- Outlook / Microsoft 365 (Microsoft Graph) ----
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# The mailbox the digest is sent FROM, ideally a shared or service mailbox.
MS_SENDER=marketing@yourcompany.com
# The developer config document uses AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET
# and MAIL_FROM for the same four values. Either set of names works.

# ---- Who gets the digest (comma separated) ----
DIGEST_TO=you@yourcompany.com,teammate@yourcompany.com

# ---- Protects the manual test address. Use any long random string. ----
CRON_SECRET=

# Link shown at the bottom of the email.
APP_URL=https://your-site.netlify.app

# Which timezone counts as "today" when working out overdue dates.
DIGEST_TZ=Asia/Kolkata

# ---- Optional: use Resend instead of Outlook for a first test ----
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# DIGEST_FROM=Marketing Hub <onboarding@resend.dev>

# ---- Send to SPOC, Claude follow-ups and the nudge job (these use Resend and Claude) ----
# RESEND_API_KEY=
# EMAIL_FROM=Marketing Hub <onboarding@resend.dev>
# ANTHROPIC_API_KEY=
# Set to false to switch the nudge automation off without redeploying.
# NUDGE_AUTOMATION_ENABLED=true
# Set to true to let it decide and draft without actually emailing.
# NUDGE_DRY_RUN=false

# ---- Canva design from a prompt (Studio, Canva tab) ----
# ANTHROPIC_API_KEY is listed above.
# Canva sign-in is done once in the browser at /api/canva-auth-start, no token to paste.
# CANVA_MCP_TOKEN= (optional fallback only)
# DESIGN_ACCESS_CODE=
# DESIGN_DAILY_LIMIT=30
# DESIGN_FOLDER_ID=FAHXCuuZDbg

# ---- Tech: Zoom Webinars and Luma (read only) ----
# Zoom: create a Server-to-Server OAuth app at marketplace.zoom.us, add the webinar and report read scopes, activate it.
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# Email of the licensed webinar host (recommended). Leave empty to look at the first few users on the account.
# ZOOM_HOST_EMAIL=
# Luma: needs a Luma Plus plan. Create the key in your calendar settings, Developer section.
# LUMA_API_KEY=
# Optional: if set, the integration backend only answers callers who enter this code in the Tech section.
# HUB_ACCESS_CODE=
